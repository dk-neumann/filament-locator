# Copy this file to .env and fill in your own values.

# IP address or hostname of the WLED controller
WLED_HOST=192.168.1.50

# Spoolman address (localhost works when Spoolman runs on the same machine)
SPOOLMAN_URL=http://localhost:7912

# Web port for this app
PORT=7920

# Lights turn off after this many seconds; 0 = stay lit until "Lights off"
AUTO_OFF_SECONDS=120

# LED brightness, 1-255
BRIGHTNESS=150

# "filament" = light each slot in the spool's own color, or a fixed hex like FFFFFF
LIGHT_COLOR=filament
